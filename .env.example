# Change this to the deployed backend origin, then rebuild the Flutter app.
# Do not add /api/v1 and do not add a trailing slash.
API_BASE_URL=https://api.example.com
APP_VERSION=1.0.0

# OAuth client ID for iOS/web where required by the platform plugin.
GOOGLE_CLIENT_ID=
# Web/server OAuth client ID. The backend GOOGLE_CLIENT_IDS must accept it.
GOOGLE_SERVER_CLIENT_ID=

# Firebase Web App values from Firebase Console > Project settings. These are
# public client identifiers; never put the Firebase service-account JSON here.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=
